{
  "name": "nextbone-firestore",
  "version": "0.9.2",
  "description": "Classes to use Firestore with Nextbone",
  "repository": "blikblum/nextbone-firestore",
  "author": "Luiz Américo Pereira Câmara",
  "contributors": [
    "Luiz Américo Pereira Câmara"
  ],
  "license": "MIT",
  "keywords": [
    "nextbone",
    "firestore",
    "firebase",
    "state"
  ],
  "type": "module",
  "main": "index.js",
  "types": "types/index.d.ts",
  "peerDependencies": {
    "firebase": ">=12.6.0",
    "nextbone": ">=0.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "chai": "^6.2.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "firebase": "^12.18.0",
    "firebase-tools": "^15.29.0",
    "globals": "^17.12.0",
    "lodash-es": "^4.18.1",
    "mocha": "^12.0.0",
    "nanoid": "^6.0.1",
    "nextbone": "^0.31.2",
    "prettier": "^3.9.6",
    "sinon": "^22.1.0",
    "sinon-chai": "^4.0.1",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "lint": "eslint src test",
    "start-firestore": "firebase emulators:start --only firestore",
    "test": "mocha --require test/setup.js test/*.spec.js",
    "test:watch": "mocha --watch --require test/setup.js test/*.spec.js",
    "generate-types": "tsc --project tsconfig.types.json"
  },
  "files": [
    "index.js",
    "src",
    "types",
    "LICENSE.txt"
  ],
  "packageManager": "yarn@4.18.0"
}
